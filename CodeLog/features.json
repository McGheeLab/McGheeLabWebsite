{
 "_comment": "The feature registry (V3.868). Every feature-sized thing in RM, the site and Scientia, with the files that make it. scripts/merge_check.py reads it on every git push: a new module must be registered here, and two features that look alike must say how they relate (extends | merges_into | related | distinct_from). Keywords are what the feature is ABOUT; the checker tokenises identifiers, labels and file names in a push and compares them with these.",
 "version": 1,
 "sides": {
  "rm": "the lab site (rm/)",
  "site": "the parent website",
  "scientia": "Gabe's app (scientia/src)",
  "shared": "the layer that joins them"
 },
 "relations": {
  "extends": "built on that feature (one id)",
  "merges_into": "this feature is being folded into that one; new work goes there (status: retiring)",
  "related": "uses or links to those features; not a duplicate",
  "distinct_from": "{id: reason} — looks similar, reviewed, kept separate on purpose",
  "status": "active (default) | retiring | decision | merged",
  "desktop_only": "true when the feature never ships in the web build"
 },
 "feature_dirs": [
  "rm/js/*.js",
  "rm/pages/*.html",
  "functions/*.js",
  "scientia/src/*.js",
  "rm/scientia/*.js",
  "rm/scientia/*.py",
  "*.js"
 ],
