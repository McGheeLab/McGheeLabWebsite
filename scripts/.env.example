# Slack → Lab Chat export — environment template
# Copy to scripts/.env and fill in real values. DO NOT COMMIT scripts/.env.

# Workspace-owner Slack user OAuth token (xoxp-...).
# Required scopes:
#   users:read, users:read.email
#   channels:history, channels:read
#   groups:history, groups:read
#   im:history, im:read
#   mpim:history, mpim:read
#   files:read, reactions:read
SLACK_USER_TOKEN=xoxp-REPLACE-ME

# Path to Firebase Admin SDK service account JSON
FIREBASE_SA_PATH=/absolute/path/to/firebase-service-account.json

# Firebase project id (e.g. mcgheelab)
FIREBASE_PROJECT_ID=mcgheelab

# Storage bucket (usually <project-id>.appspot.com)
FIREBASE_BUCKET=mcgheelab.appspot.com

# UID to credit as creator of imported channels (use a chat-admin uid)
IMPORTER_UID=REPLACE-ME
