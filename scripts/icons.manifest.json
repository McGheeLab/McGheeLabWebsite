  "keep": {
    "_why": "Deliberately NOT icons. Do not add these to `icons` later without re-reading the reason.",
    "◌": "no_result outcome - reads as a SET with ◇ and ✗ in my-week.js; breaking one out to SVG breaks the set",
    "◇": "recordable outcome - same set",
    "⌖": "position marker - same family",
    "⊡": "the '⊡ Split' GROUP KEY compared against p.group in all-pages.js:196 - changing it silently breaks grouping",
    "·": "prose separator, not iconography",
    "─": "box-drawing in comment banners (~41k occurrences)",
    "═": "box-drawing in training-page diagrams (~19k occurrences)"
  },
  "tint": {
    "_why": "Coloured-shape emoji whose colour carries meaning (status, user-picked markers). ICON.render() draws the named icon (solid where shipped) in that colour instead of the colour-emoji image. Never also list these under icons{}.",
