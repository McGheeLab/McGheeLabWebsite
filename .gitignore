~$*

# Node
node_modules/

# Slack export — secrets and resume state
scripts/.env
scripts/.slack_export_checkpoint.json
# Pasted Slack chat backups awaiting import (V3.582) — private DM
# content (incl. passwords); never commit, never FTP.
slack backup*.md

# Firebase service account JSON used by one-off migration scripts (V3.212+)
scripts/service-account.json

# Accidental gcloud SDK extraction — not project code
gcloud auth login/
# Exceeds GitHub 100MB push limit (embedded images?) — needs LFS or asset split
Data/protocols/GELS Lab Notebook.md
# Private student documents (LORs, personal statements, CVs) — never publish
Data/LOR requests/

# App Store Connect API keys — never commit
AuthKey_*.p8
*.p8

# Deploy tooling (V3.817) — the staging folder is regenerated by scripts/deploy.py stage,
# pending.json is transient, audit reports name private files. deploy/manifest.json IS tracked:
# it is the record of what is live on mcgheelab.com.
deploy/upload/
deploy/pending.json
deploy/audit-*.txt

# Scientia (V3.866): one source tree in scientia/, two build outputs — run scripts/scientia_build.py after a pull.
# Gabe's desktop data never belongs in git.
scientia/scientia.html
rm/scientia/scientia.html
scientia/images/
scientia/recordings/
scientia/backup/
scientia/pairing-report.txt

# Confidential lab data — the GitHub repo is PUBLIC (V3.868). Payroll, ledgers, grant documents and the
# startup spreadsheet never belong in git; vendor manuals are big and copyrighted. scripts/git_autopush.py
# holds these patterns out of every commit even if this list misses one.
Data/payroll*
Data/transactions*
Data/*.csv
Data/*.xlsx
Data/Grants/
Data/equipment/*.pdf
Data/cell culture/*.pdf
**/*.paperbundle.zip
# Course rosters (FERPA) — never in git; modules/**/students.md was tracked until V3.868
modules/**/students.md
modules/**/*roster*

# Gabe's raw source archives (the source itself lives in scientia/)
*scientia-notebook-code*.zip
