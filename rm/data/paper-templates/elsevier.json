{
  "schema_version": 2,
  "id": "elsevier",
  "name": "Elsevier (elsarticle, preprint layout)",
  "group": "Publishers",
  "description": "Generic Elsevier journal submission — elsarticle class in single-column preprint layout, numeric [1] citations (elsarticle-num.bst, \\citep via the class's natbib), frontmatter with structured abstract and keywords. Works for most Elsevier titles; swap the bibliography style at submission if the journal asks for a variant.",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "citation": {
    "command": "\\citep",
    "narrative_command": "\\citet",
    "render_family": "numeric-bracket",
    "bibliography_style": "elsarticle-num"
  },
  "refs": {
    "figure": {
      "prefix": "Fig.~"
    },
    "table": {
      "prefix": "Table~"
    },
    "equation": {
      "prefix": "Eq.~",
      "command": "\\eqref"
    }
  },
  "author_block": {
    "format": "elsarticle"
  },
  "limits": {},
  "addon_defaults": [
    "lineno",
    "setspace-double"
  ],
  "preamble": "\\documentclass[preprint,12pt]{elsarticle}\n\n% Generated by ResearchManagement paper builder — Elsevier (elsarticle) template.\n% elsarticle loads natbib itself; do not load it again here.\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage{amsmath, amssymb}\n\\usepackage{graphicx}\n\\usepackage{booktabs}\n\\usepackage[hidelinks]{hyperref}\n\\usepackage{xcolor}\n\\usepackage{float}\n\\usepackage{caption}\n\\usepackage{subcaption}\n",
  "main_template": "{{PREAMBLE}}\n\n\\begin{document}\n\n\\begin{frontmatter}\n\n\\title{ {{TITLE}} }\n\n{{AUTHOR_BLOCK}}\n\n\\begin{abstract}\n{{ABSTRACT}}\n\\end{abstract}\n\n\\begin{keyword}\n{{KEYWORDS}}\n\\end{keyword}\n\n{{GRAPHICAL_ABSTRACT}}\n\n\\end{frontmatter}\n\n{{INPUTS}}\n\n\\bibliographystyle{elsarticle-num}\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
  "section_kind_to_command": {
    "abstract": "abstract_placeholder",
    "keywords": "keywords_placeholder",
    "introduction": "section",
    "background": "section",
    "methods": "section",
    "results": "section",
    "discussion": "section",
    "conclusions": "section",
    "acknowledgements": "section_star",
    "references": "skip",
    "custom": "section"
  },
  "default_section_label": {
    "abstract": "Abstract",
    "introduction": "Introduction",
    "background": "Background",
    "methods": "Materials and Methods",
    "results": "Results",
    "discussion": "Discussion",
    "conclusions": "Conclusion",
    "acknowledgements": "Acknowledgements"
  },
  "special_sections": [
    {
      "key": "credit_authorship",
      "label": "CRediT authorship contribution statement",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "declaration_competing",
      "label": "Declaration of competing interest",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "data_availability",
      "label": "Data availability",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "acknowledgements",
      "label": "Acknowledgements",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    }
  ],
  "render_hints": {
    "layout": {
      "figure_widths_mm": {
        "single": 90,
        "oneAndHalf": 140,
        "double": 190
      },
      "figure_max_height_mm": null,
      "allowed_placements": [
        "t",
        "b",
        "p"
      ],
      "allow_here": false,
      "notes": "Elsevier: 90 mm single / 140 mm 1.5 / 190 mm double column."
    }
  },
  "look": {
    "engine": "spec",
    "name": "Elsevier (published page)",
    "measured_from": "Mechanobiology in Medicine 2, 100063 (2024) — 595.3×793.7 bp, two columns",
    "page": {
      "w": 595.3,
      "h": 793.7
    },
    "margins": {
      "top": 52.9,
      "bottom": 50.4,
      "left": 37.6,
      "right": 37.5
    },
    "columns": 2,
    "colsep": 17.8,
    "fonts": {
      "text": "termes",
      "sans": "heros"
    },
    "body": {
      "size": 8,
      "lead": 10.5,
      "indent": 8,
      "parskip": 0,
      "flushbottom": true
    },
    "title": {
      "family": "text",
      "size": 14,
      "lead": 17,
      "weight": "normal",
      "align": "left",
      "after": 8
    },
    "authors": {
      "family": "text",
      "size": 9.5,
      "lead": 12,
      "align": "left",
      "after": 4
    },
    "affiliations": {
      "family": "text",
      "size": 6.4,
      "lead": 8,
      "style": "italic",
      "align": "left",
      "where": "front",
      "after": 10
    },
    "abstract": {
      "mode": "span",
      "family": "text",
      "size": 7.2,
      "lead": 9.5,
      "label": "ABSTRACT",
      "label_style": "heading",
      "label_size": 6.4,
      "label_lead": 9,
      "label_weight": "normal",
      "indent": 0,
      "after": 12,
      "box": {
        "pad": 5
      }
    },
    "keywords": {
      "show": true,
      "label": "Keywords:",
      "size": 7.2,
      "lead": 9.5
    },
    "h1": {
      "family": "text",
      "size": 8,
      "lead": 10.5,
      "weight": "bold",
      "before": 10,
      "after": 4,
      "align": "left"
    },
    "h2": {
      "family": "text",
      "size": 8,
      "lead": 10.5,
      "style": "italic",
      "before": 7,
      "after": 3,
      "align": "left"
    },
    "h3": {
      "family": "text",
      "size": 8,
      "lead": 10.5,
      "style": "italic",
      "before": 5,
      "after": 2,
      "align": "left"
    },
    "caption": {
      "family": "text",
      "size": 6.4,
      "lead": 8,
      "label_fig": "Fig.",
      "label_tab": "Table",
      "label_weight": "bold",
      "sep": ". ",
      "align": "justify",
      "skip": 5,
      "table_position": "above"
    },
    "bib": {
      "size": 6.4,
      "lead": 8,
      "head": "References",
      "label": "bracket",
      "sep": 0.5
    },
    "cite": {
      "style": "bracket"
    },
    "display": {
      "above": 6,
      "below": 6
    },
    "floats": {
      "textfloatsep": 14,
      "floatsep": 12,
      "intextsep": 10,
      "topfraction": 0.9,
      "bottomfraction": 0.6,
      "textfraction": 0.08,
      "floatpagefraction": 0.8,
      "dbltopfraction": 0.9,
      "dblfloatpagefraction": 0.8,
      "topnumber": 3,
      "bottomnumber": 2,
      "totalnumber": 4,
      "dbltopnumber": 2
    },
    "footer": {
      "page_numbers": true
    }
  },
  "figure_environment": {
    "compiled_columns": 1,
    "env": "figure",
    "placement": "H",
    "default_width": "0.9\\linewidth"
  },
  "table_environment": {
    "caption_position": "below",
    "env": "table",
    "placement": "H",
    "use_booktabs": true
  },
  "equation_environment": {
    "display": "equation",
    "inline_delim": "$"
  }
}