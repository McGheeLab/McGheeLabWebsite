{
  "schema_version": 2,
  "id": "preprint-authoryear",
  "name": "Preprint — author-year citations",
  "group": "Preprints",
  "description": "Clean single-column article with (Author, Year) parenthetical citations (plainnat). Good for fields and venues that prefer author-year style, and for drafts before a target journal is chosen.",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "citation": {
    "command": "\\citep",
    "narrative_command": "\\citet",
    "render_family": "author-year",
    "bibliography_style": "plainnat"
  },
  "refs": {
    "figure": {
      "prefix": "Fig.~"
    },
    "table": {
      "prefix": "Table~"
    },
    "equation": {
      "prefix": "Eq.~",
      "command": "\\eqref"
    }
  },
  "limits": {},
  "addon_defaults": [
    "lineno"
  ],
  "preamble": "\\documentclass[11pt]{article}\n\n% Generated by ResearchManagement paper builder — preprint (author-year) template.\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage{amsmath, amssymb}\n\\usepackage{graphicx}\n\\usepackage[margin=1in]{geometry}\n\\usepackage{booktabs}\n\\usepackage[hidelinks]{hyperref}\n\\usepackage{xcolor}\n\\usepackage{float}\n\\usepackage{caption}\n\\usepackage{subcaption}\n\\usepackage[round,authoryear]{natbib}\n",
  "main_template": "{{PREAMBLE}}\n\n\\title{ {{TITLE}} }\n\\author{ {{LEAD_AUTHOR}} }\n\\date{}\n\n\\begin{document}\n\\maketitle\n\n{{INPUTS}}\n\n\\bibliographystyle{plainnat}\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
  "section_kind_to_command": {
    "abstract": "abstract_env",
    "keywords": "skip",
    "introduction": "section",
    "background": "section",
    "methods": "section",
    "results": "section",
    "discussion": "section",
    "conclusions": "section",
    "acknowledgements": "section_star",
    "references": "skip",
    "custom": "section"
  },
  "default_section_label": {
    "abstract": "Abstract",
    "introduction": "Introduction",
    "background": "Background",
    "methods": "Materials and Methods",
    "results": "Results",
    "discussion": "Discussion",
    "conclusions": "Conclusion",
    "acknowledgements": "Acknowledgements"
  },
  "special_sections": [
    {
      "key": "acknowledgements",
      "label": "Acknowledgements",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "author_contributions",
      "label": "Author Contributions",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "data_availability",
      "label": "Data Availability",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "funding",
      "label": "Funding",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    }
  ],
  "render_hints": {
    "layout": {
      "figure_widths_frac": {
        "single": 0.5,
        "oneAndHalf": 0.7,
        "double": 1.0
      },
      "allowed_placements": [
        "H",
        "h",
        "t",
        "b",
        "p"
      ],
      "allow_here": true,
      "notes": "Preprint — author controls layout; fractions of \\linewidth."
    }
  },
  "figure_environment": {
    "compiled_columns": 1,
    "env": "figure",
    "placement": "H",
    "default_width": "0.9\\linewidth"
  },
  "table_environment": {
    "caption_position": "below",
    "env": "table",
    "placement": "H",
    "use_booktabs": true
  },
  "equation_environment": {
    "display": "equation",
    "inline_delim": "$"
  }
}
