{
  "schema_version": 2,
  "id": "mebp-journal",
  "name": "Journal article (MEBP / SLAS Technology style)",
  "group": "Lab journals",
  "description": "Modular article with abstract + introduction + methods + results + discussion + conclusion sections. Uses natbib superscript citations, 1in margins, 11pt a4. Designed to drop into a sibling repo alongside the MEBP-Paper template.",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "cite_command": "\\cite",
  "citation_style": "natbib",
  "output_mode_default": "preview",
  "citation": {
    "command": "\\cite",
    "narrative_command": "\\cite",
    "render_family": "superscript",
    "bibliography_style": "unsrtnat"
  },
  "refs": {
    "figure": {
      "prefix": "Fig.~"
    },
    "table": {
      "prefix": "Table~"
    },
    "equation": {
      "prefix": "Eq.~",
      "command": "\\eqref"
    }
  },
  "preamble": "\\documentclass[11pt, a4paper]{article}\n\n% Generated by ResearchManagement paper builder.\n% This preamble mirrors the MEBP-Paper template; tweak as needed.\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage{amsmath, amssymb}\n\\usepackage{graphicx}\n\\usepackage[margin=1in]{geometry}\n\\usepackage{booktabs}\n\\usepackage{siunitx}\n\\usepackage[hidelinks]{hyperref}\n\\usepackage{cleveref}\n\\usepackage{xcolor}\n\\usepackage{float}\n\\usepackage{caption}\n\\usepackage{subcaption}\n\\usepackage[super,sort&compress,comma]{natbib}\n\\usepackage{microtype}\n\\usepackage{lineno}\n\\linenumbers\n",
  "main_template": "{{PREAMBLE}}\n\n\\title{ {{TITLE}} }\n\n\\author{\n  {{AUTHOR_BLOCK}}\n}\n\n\\date{}\n\n\\begin{document}\n\\maketitle\n\n{{INPUTS}}\n\n\\bibliographystyle{unsrtnat}\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
  "section_kind_to_command": {
    "abstract": "abstract_env",
    "keywords": "skip",
    "introduction": "section",
    "background": "section",
    "methods": "section",
    "results": "section",
    "discussion": "section",
    "conclusions": "section",
    "acknowledgements": "section_star",
    "references": "skip",
    "custom": "section_star"
  },
  "default_section_label": {
    "abstract": "Abstract",
    "introduction": "Introduction",
    "background": "Background",
    "methods": "Materials and Methods",
    "results": "Results",
    "discussion": "Discussion",
    "conclusions": "Conclusion",
    "acknowledgements": "Acknowledgements"
  },
  "special_sections": [
    {
      "key": "acknowledgements",
      "label": "Acknowledgements",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "author_contributions",
      "label": "Author Contributions",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "data_availability",
      "label": "Data Availability",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "funding",
      "label": "Funding",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    }
  ],
  "render_hints": {
    "layout": {
      "figure_widths_frac": {
        "single": 0.5,
        "oneAndHalf": 0.7,
        "double": 1.0
      },
      "allowed_placements": [
        "H",
        "h",
        "t",
        "b",
        "p"
      ],
      "allow_here": true,
      "notes": "Self-published journal format — author controls layout; fractions of \\linewidth."
    }
  },
  "figure_environment": {
    "compiled_columns": 1,
    "env": "figure",
    "placement": "H",
    "default_width": "0.9\\linewidth"
  },
  "table_environment": {
    "caption_position": "below",
    "env": "table",
    "placement": "H",
    "use_booktabs": true
  },
  "equation_environment": {
    "display": "equation",
    "inline_delim": "$"
  }
}
