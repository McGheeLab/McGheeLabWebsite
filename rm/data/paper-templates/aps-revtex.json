{
  "schema_version": 2,
  "id": "aps-revtex",
  "name": "Physical Review / APS (REVTeX 4.2)",
  "group": "Publishers",
  "description": "American Physical Society journals (Phys. Rev. Lett./X/E, …). The published look is a two-column Times page measured from a Physical Review article; the submission manuscript compiles with the official revtex4-2 class (aps, reprint) and its apsrev4-2 bibliography style, both in TeX Live.",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "citation": {
    "command": "\\cite",
    "narrative_command": "\\cite",
    "render_family": "numeric-bracket",
    "bibliography_style": "apsrev4-2"
  },
  "refs": {
    "figure": {
      "prefix": "Fig.~"
    },
    "table": {
      "prefix": "Table~"
    },
    "equation": {
      "prefix": "Eq.~",
      "command": "\\eqref"
    }
  },
  "limits": {
    "abstract_words": 250
  },
  "addon_defaults": [],
  "preamble": "\\documentclass[aps,prx,reprint,superscriptaddress,amsmath,amssymb,floatfix]{revtex4-2}\n\n% Generated by the McGhee Lab paper builder — APS REVTeX 4.2 submission.\n% revtex4-2 loads natbib and the apsrev4-2 bibliography style itself.\n\\usepackage{graphicx}\n\\usepackage{booktabs}\n\\usepackage{xcolor}\n\\usepackage[hidelinks]{hyperref}\n",
  "main_template": "{{PREAMBLE}}\n\n\\begin{document}\n\n\\title{ {{TITLE}} }\n{{AUTHOR_BLOCK}}\n\n\\begin{abstract}\n{{ABSTRACT}}\n\\end{abstract}\n\n\\maketitle\n\n{{INPUTS}}\n\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
  "author_block": {
    "format": "revtex"
  },
  "section_kind_to_command": {
    "abstract": "abstract_placeholder",
    "keywords": "skip",
    "introduction": "section",
    "background": "section",
    "methods": "section",
    "results": "section",
    "discussion": "section",
    "conclusions": "section",
    "acknowledgements": {
      "type": "env",
      "name": "acknowledgments"
    },
    "references": "skip",
    "custom": "section"
  },
  "default_section_label": {
    "abstract": "Abstract",
    "introduction": "Introduction",
    "background": "Background",
    "methods": "Materials and Methods",
    "results": "Results",
    "discussion": "Discussion",
    "conclusions": "Conclusion",
    "acknowledgements": "Acknowledgements"
  },
  "special_sections": [
    {
      "key": "acknowledgements",
      "label": "Acknowledgments",
      "command": {
        "type": "env",
        "name": "acknowledgments"
      },
      "singleton": true,
      "default_position": "back",
      "preview": "heading",
      "hint": "REVTeX acknowledgments environment."
    },
    {
      "key": "author_contributions",
      "label": "Author contributions",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading",
      "hint": "Unnumbered back-matter section."
    },
    {
      "key": "data_availability",
      "label": "Data availability",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading",
      "hint": "Unnumbered back-matter section."
    }
  ],
  "figure_environment": {
    "compiled_columns": 2,
    "env": "figure",
    "placement": "tbp",
    "default_width": "\\linewidth"
  },
  "table_environment": {
    "caption_position": "above",
    "env": "table",
    "placement": "tbp",
    "use_booktabs": true
  },
  "equation_environment": {
    "display": "equation",
    "inline_delim": "$"
  },
  "look": {
    "engine": "spec",
    "name": "Physical Review (published page)",
    "measured_from": "arXiv:1409.0593 (REVTeX reprint, Times) — US Letter, two columns",
    "page": {
      "w": 612,
      "h": 792
    },
    "margins": {
      "top": 54.2,
      "bottom": 68.2,
      "left": 54,
      "right": 49.9
    },
    "columns": 2,
    "colsep": 17.9,
    "fonts": {
      "text": "termes",
      "sans": "heros"
    },
    "body": {
      "size": 10,
      "lead": 12,
      "indent": 10,
      "parskip": 0,
      "flushbottom": true
    },
    "title": {
      "family": "text",
      "size": 12,
      "lead": 14,
      "weight": "bold",
      "align": "center",
      "after": 8
    },
    "authors": {
      "family": "text",
      "size": 10,
      "lead": 12,
      "align": "center",
      "after": 3
    },
    "affiliations": {
      "family": "text",
      "size": 9,
      "lead": 11,
      "style": "italic",
      "align": "center",
      "where": "front",
      "after": 10
    },
    "abstract": {
      "mode": "span",
      "family": "text",
      "size": 9,
      "lead": 11,
      "label": null,
      "indent": 36,
      "after": 16
    },
    "keywords": {
      "show": false
    },
    "h1": {
      "family": "text",
      "size": 9,
      "lead": 11,
      "weight": "bold",
      "case": "upper",
      "before": 12,
      "after": 6,
      "align": "center"
    },
    "h2": {
      "family": "text",
      "size": 9,
      "lead": 11,
      "weight": "bold",
      "before": 8,
      "after": 4,
      "align": "center"
    },
    "h3": {
      "family": "text",
      "size": 9,
      "lead": 11,
      "style": "italic",
      "before": 6,
      "after": 2,
      "align": "center"
    },
    "numbering": "ieee",
    "caption": {
      "family": "text",
      "size": 9,
      "lead": 10.5,
      "label_fig": "FIG.",
      "label_tab": "TABLE",
      "label_weight": "normal",
      "sep": ". ",
      "align": "justify",
      "skip": 6,
      "table_position": "above"
    },
    "bib": {
      "size": 9,
      "lead": 10.5,
      "head": "",
      "label": "bracket",
      "sep": 0
    },
    "cite": {
      "style": "bracket"
    },
    "display": {
      "above": 6,
      "below": 6
    },
    "floats": {
      "textfloatsep": 14,
      "floatsep": 12,
      "intextsep": 10,
      "topfraction": 0.9,
      "bottomfraction": 0.6,
      "textfraction": 0.08,
      "floatpagefraction": 0.8,
      "dbltopfraction": 0.9,
      "dblfloatpagefraction": 0.8,
      "topnumber": 3,
      "bottomnumber": 2,
      "totalnumber": 4,
      "dbltopnumber": 2
    },
    "footer": {
      "page_numbers": true
    }
  }
}
