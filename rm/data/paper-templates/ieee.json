{
  "schema_version": 2,
  "id": "ieee",
  "name": "IEEE journal (IEEEtran)",
  "group": "Publishers",
  "description": "IEEE Transactions journal format — IEEEtran class, inherently two-column, numeric [1] citations (IEEEtran.bst), IEEEkeywords block. Figures default to column width at the top of the column. Leave the two-column add-on off (the class is already two-column).",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "citation": {
    "command": "\\cite",
    "narrative_command": "\\cite",
    "render_family": "numeric-bracket",
    "bibliography_style": "IEEEtran"
  },
  "refs": {
    "figure": {
      "prefix": "Fig.~"
    },
    "table": {
      "prefix": "Table~"
    },
    "equation": {
      "prefix": "",
      "command": "\\eqref"
    }
  },
  "author_block": {
    "format": "ieee"
  },
  "limits": {},
  "incompatible_addons": [
    "twocolumn"
  ],
  "preamble": "\\documentclass[journal]{IEEEtran}\n\n% Generated by ResearchManagement paper builder — IEEE journal template.\n% IEEEtran manages layout, fonts, and captions itself; keep the preamble lean.\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage{amsmath, amssymb}\n\\usepackage{graphicx}\n\\usepackage{booktabs}\n\\usepackage[hidelinks]{hyperref}\n\\usepackage{xcolor}\n\\usepackage{float}\n",
  "main_template": "{{PREAMBLE}}\n\n\\begin{document}\n\n\\title{ {{TITLE}} }\n{{AUTHOR_BLOCK}}\n\\maketitle\n\n\\begin{abstract}\n{{ABSTRACT}}\n\\end{abstract}\n\n\\begin{IEEEkeywords}\n{{KEYWORDS}}\n\\end{IEEEkeywords}\n\n{{INPUTS}}\n\n\\bibliographystyle{IEEEtran}\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
  "section_kind_to_command": {
    "abstract": "abstract_placeholder",
    "keywords": "keywords_placeholder",
    "introduction": "section",
    "background": "section",
    "methods": "section",
    "results": "section",
    "discussion": "section",
    "conclusions": "section",
    "acknowledgements": "section_star",
    "references": "skip",
    "custom": "section"
  },
  "default_section_label": {
    "abstract": "Abstract",
    "introduction": "Introduction",
    "background": "Background",
    "methods": "Methods",
    "results": "Results",
    "discussion": "Discussion",
    "conclusions": "Conclusion",
    "acknowledgements": "Acknowledgment"
  },
  "special_sections": [
    {
      "key": "acknowledgment",
      "label": "Acknowledgment",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "author_contributions",
      "label": "Author Contributions",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "data_availability",
      "label": "Data Availability",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    }
  ],
  "render_hints": {
    "layout": {
      "figure_widths_mm": {
        "single": 88.9,
        "oneAndHalf": null,
        "double": 181.9
      },
      "figure_max_height_mm": null,
      "allowed_placements": [
        "t",
        "p"
      ],
      "default_placement": "!t",
      "allow_here": false,
      "notes": "IEEEtran two-column: 3.5 in (88.9 mm) column / 7.16 in (181.9 mm) page. Floats top-of-column ([!t])."
    }
  },
  "look": {
    "engine": "class",
    "name": "IEEE Transactions (IEEEtran journal page)",
    "measured_from": "IEEEtran.cls v1.8b [journal]: sizes, skips, float parameters from the class; page geometry and front-matter skips measured from a compile (sizes in TeX pt → bp)",
    "page": {
      "w": 612,
      "h": 792
    },
    "margins": {
      "top": 54.57,
      "bottom": 46.03,
      "left": 48.96,
      "right": 48.95
    },
    "columns": 2,
    "colsep": 11.95,
    "numbering": "ieee",
    "indent_after_heading": true,
    "fonts": {
      "text": "termes",
      "sans": "heros"
    },
    "glue": {
      "text": {
        "space": 0.35,
        "stretch": 0.4286,
        "shrink": 0.3429
      },
      "text-bold": {
        "space": 0.375,
        "stretch": 0.4667,
        "shrink": 0.3867
      }
    },
    "glue_note": "IEEEtran retunes the roman fontdimens: space 0.35em (0.23-0.50), bold 0.375em (0.23-0.55)",
    "body": {
      "size": 9.963,
      "lead": 11.955,
      "indent": 9.963,
      "parskip": 0,
      "flushbottom": true,
      "topskip": 9.963
    },
    "title": {
      "family": "text",
      "size": 23.91,
      "lead": 27.86,
      "weight": "normal",
      "align": "center",
      "before": 5.9,
      "after": 10.1
    },
    "authors": {
      "family": "text",
      "size": 10.959,
      "lead": 13.3,
      "align": "center",
      "after": 40.74,
      "and": "and"
    },
    "affiliations": {
      "where": "colnote",
      "prefix": "The authors are with ",
      "family": "text",
      "size": 7.97,
      "lead": 8.966,
      "indent": 7.97,
      "note_skip": 9.73,
      "after": 0
    },
    "abstract": {
      "mode": "column",
      "family": "text",
      "size": 8.966,
      "lead": 9.963,
      "weight": "bold",
      "label": "Abstract—",
      "label_style": "runin",
      "label_italic": true,
      "label_sep": "",
      "first_indent": 9.963,
      "indent": 0,
      "before": 0,
      "after": 5.44,
      "parbox": false
    },
    "keywords": {
      "show": true,
      "label": "Index Terms—",
      "label_italic": true,
      "label_sep": "",
      "family": "text",
      "size": 8.966,
      "lead": 9.963,
      "weight": "bold",
      "indent": 9.963,
      "before": 5.44,
      "after": 1.3
    },
    "h1": {
      "family": "text",
      "size": 9.963,
      "lead": 11.955,
      "weight": "normal",
      "case": "smallcaps",
      "align": "center",
      "before": 13.45,
      "after": 3.14
    },
    "h2": {
      "family": "text",
      "size": 9.963,
      "lead": 11.955,
      "weight": "normal",
      "style": "italic",
      "align": "left",
      "before": 15.69,
      "after": 3.14
    },
    "h3": {
      "family": "text",
      "size": 9.963,
      "lead": 11.955,
      "weight": "normal",
      "style": "italic",
      "runin": true,
      "runin_sep": ":",
      "before": 0,
      "after": 0
    },
    "caption": {
      "family": "text",
      "size": 7.97,
      "lead": 8.966,
      "label_fig": "Fig.",
      "label_tab": "TABLE",
      "label_weight": "normal",
      "sep": ".  ",
      "align": "justify",
      "skip": 20.8,
      "table_position": "above"
    },
    "bib": {
      "size": 7.97,
      "lead": 8.966,
      "label": "bracket",
      "sep": 0
    },
    "cite": {
      "style": "ieee"
    },
    "display": {
      "above": 6.72,
      "below": 6.72
    },
    "floats": {
      "textfloatsep": 18.531,
      "floatsep": 10.162,
      "intextsep": 10.162,
      "topfraction": 0.9,
      "bottomfraction": 0.4,
      "textfraction": 0.1,
      "floatpagefraction": 0.8,
      "dbltopfraction": 0.8,
      "dblfloatpagefraction": 0.8,
      "topnumber": 2,
      "bottomnumber": 2,
      "totalnumber": 4,
      "dbltopnumber": 4
    },
    "linebreak": {
      "pretolerance": 100,
      "tolerance": 800,
      "emergency": 1.5,
      "hyphenpenalty": 750,
      "relpenalty": 800,
      "binoppenalty": 1000
    },
    "front_note": "front skips are TeX skips (baseline distance = skip + next baselineskip), measured from an IEEEtran compile"
  },
  "figure_environment": {
    "compiled_columns": 2,
    "env": "figure",
    "placement": "!t",
    "default_width": "\\columnwidth"
  },
  "table_environment": {
    "caption_position": "above",
    "env": "table",
    "placement": "!t",
    "use_booktabs": true
  },
  "equation_environment": {
    "display": "equation",
    "inline_delim": "$"
  }
}
