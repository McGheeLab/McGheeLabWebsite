{
  "schema_version": 2,
  "id": "ieee",
  "name": "IEEE journal (IEEEtran)",
  "group": "Publishers",
  "description": "IEEE Transactions journal format — IEEEtran class, inherently two-column, numeric [1] citations (IEEEtran.bst), IEEEkeywords block. Figures default to column width at the top of the column. Leave the two-column add-on off (the class is already two-column).",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "citation": {
    "command": "\\cite",
    "narrative_command": "\\cite",
    "render_family": "numeric-bracket",
    "bibliography_style": "IEEEtran"
  },
  "refs": {
    "figure": {
      "prefix": "Fig.~"
    },
    "table": {
      "prefix": "Table~"
    },
    "equation": {
      "prefix": "",
      "command": "\\eqref"
    }
  },
  "author_block": {
    "format": "ieee"
  },
  "limits": {},
  "incompatible_addons": [
    "twocolumn"
  ],
  "preamble": "\\documentclass[journal]{IEEEtran}\n\n% Generated by ResearchManagement paper builder — IEEE journal template.\n% IEEEtran manages layout, fonts, and captions itself; keep the preamble lean.\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage{amsmath, amssymb}\n\\usepackage{graphicx}\n\\usepackage{booktabs}\n\\usepackage[hidelinks]{hyperref}\n\\usepackage{xcolor}\n\\usepackage{float}\n",
  "main_template": "{{PREAMBLE}}\n\n\\begin{document}\n\n\\title{ {{TITLE}} }\n{{AUTHOR_BLOCK}}\n\\maketitle\n\n\\begin{abstract}\n{{ABSTRACT}}\n\\end{abstract}\n\n\\begin{IEEEkeywords}\n{{KEYWORDS}}\n\\end{IEEEkeywords}\n\n{{INPUTS}}\n\n\\bibliographystyle{IEEEtran}\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
  "section_kind_to_command": {
    "abstract": "abstract_placeholder",
    "keywords": "keywords_placeholder",
    "introduction": "section",
    "background": "section",
    "methods": "section",
    "results": "section",
    "discussion": "section",
    "conclusions": "section",
    "acknowledgements": "section_star",
    "references": "skip",
    "custom": "section"
  },
  "default_section_label": {
    "abstract": "Abstract",
    "introduction": "Introduction",
    "background": "Background",
    "methods": "Methods",
    "results": "Results",
    "discussion": "Discussion",
    "conclusions": "Conclusion",
    "acknowledgements": "Acknowledgment"
  },
  "special_sections": [
    {
      "key": "acknowledgment",
      "label": "Acknowledgment",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "author_contributions",
      "label": "Author Contributions",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "data_availability",
      "label": "Data Availability",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    }
  ],
  "render_hints": {
    "layout": {
      "figure_widths_mm": {
        "single": 88.9,
        "oneAndHalf": null,
        "double": 181.9
      },
      "figure_max_height_mm": null,
      "allowed_placements": [
        "t",
        "p"
      ],
      "default_placement": "!t",
      "allow_here": false,
      "notes": "IEEEtran two-column: 3.5 in (88.9 mm) column / 7.16 in (181.9 mm) page. Floats top-of-column ([!t])."
    }
  },
  "figure_environment": {
    "compiled_columns": 2,
    "env": "figure",
    "placement": "!t",
    "default_width": "\\columnwidth"
  },
  "table_environment": {
    "caption_position": "above",
    "env": "table",
    "placement": "!t",
    "use_booktabs": true
  },
  "equation_environment": {
    "display": "equation",
    "inline_delim": "$"
  }
}
