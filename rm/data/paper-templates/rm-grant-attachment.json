{
  "id": "rm-grant-attachment",
  "schema_version": 2,
  "name": "Grant attachment (RM submission document)",
  "description": "Compiles a single grant attached document (Facilities, Budget Justification, Data Management Plan, Mentoring Plan, Synergistic Activities, Specific Aims, Research Strategy, …) into a standalone plain single-column PDF. Not a manuscript template.",
  "main_file": "main.tex",
  "preamble": "\\documentclass[11pt]{article}\n\\usepackage[margin=1in]{geometry}\n\\usepackage[T1]{fontenc}\n\\usepackage{parskip}\n\\usepackage{microtype}\n\\usepackage{graphicx}\n\\usepackage[numbers]{natbib}",
  "main_template": "{{PREAMBLE}}\n\n\\begin{document}\n\n\\begin{center}\n{\\large\\bfseries {{TITLE}}}\n\\end{center}\n\n\\vspace{0.6em}\n\n{{INPUTS}}\n\n\\bibliographystyle{unsrtnat}\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}",
  "section_kind_to_command": {
    "project_summary": "section_star",
    "specific_aims": "section_star",
    "research_strategy": "section_star",
    "biosketch": "section_star",
    "facilities": "section_star",
    "budget": "section_star",
    "budget_justification": "section_star",
    "current_pending": "section_star",
    "collaborators_coa": "section_star",
    "synergistic_activities": "section_star",
    "data_management_plan": "section_star",
    "mentoring_plan": "section_star",
    "resource_sharing": "section_star",
    "vertebrate_animals": "section_star",
    "human_subjects": "section_star",
    "select_agents": "section_star",
    "letters_of_support": "section_star",
    "pecase_statement": "section_star",
    "custom": "section_star"
  },
  "default_section_label": {},
  "citation": { "command": "\\citep", "render_family": "numeric-bracket" },
  "figure_environment": { "env": "figure", "placement": "H", "compiled_columns": 1 },
  "table_environment": { "env": "table", "placement": "H" }
}
