{
  "schema_version": 2,
  "id": "preprint-numeric",
  "name": "Preprint — numeric citations",
  "group": "Preprints",
  "description": "Clean single-column article for bioRxiv / arXiv-style preprints and early drafts. Numeric [1] citations in first-appearance order (unsrtnat), 11pt, 1in margins, numbered sections. Suggested add-on: line numbers for review.",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "citation": {
    "command": "\\cite",
    "narrative_command": "\\cite",
    "render_family": "numeric-bracket",
    "bibliography_style": "unsrtnat"
  },
  "refs": {
    "figure": {
      "prefix": "Fig.~"
    },
    "table": {
      "prefix": "Table~"
    },
    "equation": {
      "prefix": "Eq.~",
      "command": "\\eqref"
    }
  },
  "limits": {},
  "addon_defaults": [
    "lineno"
  ],
  "preamble": "\\documentclass[11pt]{article}\n\n% Generated by ResearchManagement paper builder — preprint (numeric) template.\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage{amsmath, amssymb}\n\\usepackage{graphicx}\n\\usepackage[margin=1in]{geometry}\n\\usepackage{booktabs}\n\\usepackage[hidelinks]{hyperref}\n\\usepackage{xcolor}\n\\usepackage{float}\n\\usepackage{caption}\n\\usepackage{subcaption}\n\\usepackage[square,numbers,sort&compress]{natbib}\n",
  "main_template": "{{PREAMBLE}}\n\n\\title{ {{TITLE}} }\n\\author{ {{AUTHOR_BLOCK}} }\n\\date{}\n\n\\begin{document}\n\\maketitle\n\n{{INPUTS}}\n\n\\bibliographystyle{unsrtnat}\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
  "section_kind_to_command": {
    "abstract": "abstract_env",
    "keywords": "skip",
    "introduction": "section",
    "background": "section",
    "methods": "section",
    "results": "section",
    "discussion": "section",
    "conclusions": "section",
    "acknowledgements": "section_star",
    "references": "skip",
    "custom": "section"
  },
  "default_section_label": {
    "abstract": "Abstract",
    "introduction": "Introduction",
    "background": "Background",
    "methods": "Materials and Methods",
    "results": "Results",
    "discussion": "Discussion",
    "conclusions": "Conclusion",
    "acknowledgements": "Acknowledgements"
  },
  "special_sections": [
    {
      "key": "acknowledgements",
      "label": "Acknowledgements",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "author_contributions",
      "label": "Author Contributions",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "data_availability",
      "label": "Data Availability",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "funding",
      "label": "Funding",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    }
  ],
  "render_hints": {
    "layout": {
      "figure_widths_frac": {
        "single": 0.5,
        "oneAndHalf": 0.7,
        "double": 1.0
      },
      "allowed_placements": [
        "H",
        "h",
        "t",
        "b",
        "p"
      ],
      "allow_here": true,
      "notes": "Preprint — author controls layout; fractions of \\linewidth."
    }
  },
  "look": {
    "engine": "spec",
    "name": "Preprint (published page)",
    "measured_from": "bioRxiv 2023.03.24.534111 — a REVTeX-style LaTeX preprint, A4, one column",
    "page": {
      "w": 595.3,
      "h": 841.9
    },
    "margins": {
      "top": 54,
      "bottom": 119.4,
      "left": 54,
      "right": 33.3
    },
    "columns": 1,
    "colsep": 0,
    "fonts": {
      "text": "lm",
      "sans": "lm-sans"
    },
    "body": {
      "size": 10,
      "lead": 17.2,
      "indent": 15,
      "parskip": 0
    },
    "title": {
      "family": "text",
      "size": 11,
      "lead": 17,
      "weight": "bold",
      "align": "center",
      "after": 10
    },
    "authors": {
      "family": "text",
      "size": 10,
      "lead": 13,
      "align": "center",
      "after": 3
    },
    "affiliations": {
      "family": "text",
      "size": 9,
      "lead": 11,
      "style": "italic",
      "align": "center",
      "where": "front",
      "after": 14
    },
    "abstract": {
      "mode": "span",
      "family": "text",
      "size": 9,
      "lead": 15.5,
      "label": null,
      "indent": 40,
      "after": 24
    },
    "keywords": {
      "show": false
    },
    "h1": {
      "family": "text",
      "size": 9,
      "lead": 11,
      "weight": "bold",
      "before": 16,
      "after": 8,
      "align": "center"
    },
    "h2": {
      "family": "text",
      "size": 9,
      "lead": 11,
      "weight": "bold",
      "before": 12,
      "after": 6,
      "align": "center"
    },
    "h3": {
      "family": "text",
      "size": 9,
      "lead": 11,
      "style": "italic",
      "before": 8,
      "after": 4,
      "align": "center"
    },
    "caption": {
      "family": "text",
      "size": 9,
      "lead": 11,
      "label_fig": "FIG.",
      "label_tab": "TABLE",
      "label_weight": "normal",
      "sep": ": ",
      "align": "justify",
      "skip": 8,
      "table_position": "above"
    },
    "bib": {
      "size": 9,
      "lead": 11,
      "head": "References",
      "label": "bracket",
      "sep": 1
    },
    "cite": {
      "style": "bracket"
    },
    "display": {
      "above": 10,
      "below": 10
    },
    "floats": {
      "textfloatsep": 18,
      "floatsep": 12,
      "intextsep": 12,
      "topfraction": 0.85,
      "bottomfraction": 0.5,
      "textfraction": 0.1,
      "floatpagefraction": 0.75,
      "dbltopfraction": 0.85,
      "dblfloatpagefraction": 0.75,
      "topnumber": 2,
      "bottomnumber": 1,
      "totalnumber": 3,
      "dbltopnumber": 2
    },
    "footer": {
      "page_numbers": true
    }
  },
  "figure_environment": {
    "compiled_columns": 1,
    "env": "figure",
    "placement": "H",
    "default_width": "0.9\\linewidth"
  },
  "table_environment": {
    "caption_position": "below",
    "env": "table",
    "placement": "H",
    "use_booktabs": true
  },
  "equation_environment": {
    "display": "equation",
    "inline_delim": "$"
  }
}
