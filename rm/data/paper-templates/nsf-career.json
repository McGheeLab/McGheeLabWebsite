{
  "schema_version": 2,
  "id": "nsf-career",
  "name": "NSF CAREER (grant)",
  "group": "Grants",
  "description": "NSF CAREER / general NSF proposal narrative — single column, 11pt, 1in margins, numbered [1] citations in first-appearance order (unsrtnat). Grant attached documents (biosketch, budget, facilities, …) are managed on the Grant Docs page, not compiled into this narrative.",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "citation": {
    "command": "\\cite",
    "narrative_command": "\\cite",
    "render_family": "numeric-bracket",
    "bibliography_style": "unsrtnat"
  },
  "refs": {
    "figure": { "prefix": "Fig.~" },
    "table": { "prefix": "Table~" },
    "equation": { "prefix": "Eq.~", "command": "\\eqref" }
  },
  "limits": {},
  "addon_defaults": [],
  "preamble": "\\documentclass[11pt]{article}\n\n% Generated by ResearchManagement paper builder — NSF CAREER (grant) template.\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage{amsmath, amssymb}\n\\usepackage{graphicx}\n\\usepackage[margin=1in]{geometry}\n\\usepackage{booktabs}\n\\usepackage[hidelinks]{hyperref}\n\\usepackage{xcolor}\n\\usepackage{float}\n\\usepackage{caption}\n\\usepackage{subcaption}\n\\usepackage[square,numbers,sort&compress]{natbib}\n",
  "main_template": "{{PREAMBLE}}\n\n\\title{ {{TITLE}} }\n\\author{ {{LEAD_AUTHOR}} }\n\\date{}\n\n\\begin{document}\n\\maketitle\n\n{{INPUTS}}\n\n\\bibliographystyle{unsrtnat}\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
  "section_kind_to_command": {
    "abstract": "abstract_env",
    "introduction": "section",
    "background": "section",
    "methods": "section",
    "results": "section",
    "discussion": "section",
    "conclusions": "section",
    "acknowledgements": "section_star",
    "references": "skip",
    "custom": "section",
    "project_summary": "skip",
    "specific_aims": "skip",
    "research_strategy": "skip",
    "biosketch": "skip",
    "facilities": "skip",
    "budget": "skip",
    "budget_justification": "skip",
    "current_pending": "skip",
    "collaborators_coa": "skip",
    "synergistic_activities": "skip",
    "data_management_plan": "skip",
    "mentoring_plan": "skip",
    "resource_sharing": "skip",
    "vertebrate_animals": "skip",
    "human_subjects": "skip",
    "select_agents": "skip",
    "letters_of_support": "skip",
    "pecase_statement": "skip",
    "cover_letter": "skip",
    "suggested_reviewers": "skip"
  },
  "default_section_label": {
    "introduction": "Introduction",
    "background": "Background",
    "methods": "Research Plan",
    "acknowledgements": "Acknowledgements"
  },
  "special_sections": [
    {
      "key": "acknowledgements",
      "label": "Acknowledgements",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    }
  ],
  "render_hints": {
    "layout": {
      "figure_widths_frac": { "single": 0.5, "oneAndHalf": 0.7, "double": 1.0 },
      "allowed_placements": ["H", "h", "t", "b", "p"],
      "allow_here": true,
      "notes": "NSF grant narrative — author controls layout; fractions of \\linewidth."
    }
  },
  "figure_environment": {
    "compiled_columns": 1,
    "env": "figure",
    "placement": "H",
    "default_width": "0.9\\linewidth"
  },
  "table_environment": {
    "caption_position": "below",
    "env": "table",
    "placement": "H",
    "use_booktabs": true
  },
  "equation_environment": {
    "display": "equation",
    "inline_delim": "$"
  }
}
