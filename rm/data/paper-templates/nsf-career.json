{
  "schema_version": 2,
  "id": "nsf-career",
  "name": "NSF CAREER (grant)",
  "group": "Grants",
  "description": "NSF proposal (CAREER and the other PAPPG programs). The Document view and the PDF set the Project Description the way NSF prints it: Letter, 1 in margins, no page numbers, a PAPPG typeface, 6 lines per inch at most, numbered [1] citations, wrapped figures. References Cited is its own document. The page meter and Fit in the Check panel bring it to 15 pages.",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "citation": {
    "command": "\\cite",
    "narrative_command": "\\cite",
    "render_family": "numeric-bracket",
    "bibliography_style": "unsrtnat"
  },
  "refs": {
    "figure": {
      "prefix": "Fig.~"
    },
    "table": {
      "prefix": "Table~"
    },
    "equation": {
      "prefix": "Eq.~",
      "command": "\\eqref"
    }
  },
  "limits": {},
  "addon_defaults": [],
  "preamble": "\\documentclass[11pt]{article}\n\n% Generated by ResearchManagement paper builder — NSF CAREER (grant) template.\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage{amsmath, amssymb}\n\\usepackage{graphicx}\n\\usepackage[margin=1in]{geometry}\n\\usepackage{booktabs}\n\\usepackage[hidelinks]{hyperref}\n\\usepackage{xcolor}\n\\usepackage{float}\n\\usepackage{caption}\n\\usepackage{subcaption}\n\\usepackage[square,numbers,sort&compress]{natbib}\n",
  "main_template": "{{PREAMBLE}}\n\n\\title{ {{TITLE}} }\n\\author{ {{AUTHOR_BLOCK}} }\n\\date{}\n\n\\begin{document}\n\\maketitle\n\n{{INPUTS}}\n\n\\bibliographystyle{unsrtnat}\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
