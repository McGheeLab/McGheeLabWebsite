{
  "schema_version": 2,
  "id": "nature",
  "name": "Nature family (Nature, Nature Communications, …)",
  "group": "Publishers",
  "description": "Nature-family journals. The published look is the two-column Nature Communications page (Minion-like serif body, sans headings and captions, small-print Methods, superscript numeric citations via naturemag.bst), measured from a published article. The submission manuscript is the single-column, double-spaced, line-numbered format Nature asks for at first submission. Nature caps the main text tightly — the limits lint warns past ~200-word abstract / 4500-word body / 50 references / 8 figures.",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "citation": {
    "command": "\\cite",
    "narrative_command": "\\cite",
    "render_family": "superscript",
    "bibliography_style": "naturemag"
  },
  "refs": {
    "figure": {
      "prefix": "Fig.~"
    },
    "table": {
      "prefix": "Table~"
    },
    "equation": {
      "prefix": "Eq.~",
      "command": "\\eqref"
    }
  },
  "limits": {
    "abstract_words": 200,
    "body_words": 4500,
    "references": 50,
    "figures": 8
  },
  "addon_defaults": [
    "lineno",
    "setspace-double"
  ],
  "preamble": "\\documentclass[12pt]{article}\n\n% Generated by ResearchManagement paper builder — Nature submission approximation.\n% naturemag.bst ships with TeXLive (fetched by the compile service).\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage{amsmath, amssymb}\n\\usepackage{graphicx}\n\\usepackage[margin=1in]{geometry}\n\\usepackage{booktabs}\n\\usepackage[hidelinks]{hyperref}\n\\usepackage{xcolor}\n\\usepackage{float}\n\\usepackage{caption}\n\\usepackage{subcaption}\n\\usepackage[super,sort&compress,comma]{natbib}\n",
  "main_template": "{{PREAMBLE}}\n\n\\title{ {{TITLE}} }\n\\author{ {{AUTHOR_BLOCK}} }\n\\date{}\n\n\\begin{document}\n\\maketitle\n\n{{INPUTS}}\n\n\\bibliographystyle{naturemag}\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
  "section_kind_to_command": {
    "abstract": "abstract_env",
    "keywords": "skip",
    "introduction": "section_star",
    "background": "section_star",
    "methods": "section_star",
    "results": "section_star",
    "discussion": "section_star",
    "conclusions": "section_star",
    "acknowledgements": "section_star",
    "references": "skip",
    "custom": "section_star"
  },
  "default_section_label": {
    "abstract": "Abstract",
    "introduction": "Introduction",
    "background": "Background",
    "methods": "Methods",
    "results": "Results",
    "discussion": "Discussion",
    "conclusions": "Conclusion",
    "acknowledgements": "Acknowledgements"
  },
  "special_sections": [
    {
      "key": "methods",
      "label": "Methods",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading",
      "hint": "This journal's class is approximated for compiles — special sections render as unnumbered sections."
    },
    {
      "key": "acknowledgements",
      "label": "Acknowledgements",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading",
      "hint": "This journal's class is approximated for compiles — special sections render as unnumbered sections."
    },
    {
      "key": "author_contributions",
      "label": "Author contributions",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading",
      "hint": "This journal's class is approximated for compiles — special sections render as unnumbered sections."
    },
    {
      "key": "competing_interests",
      "label": "Competing interests",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading",
      "hint": "This journal's class is approximated for compiles — special sections render as unnumbered sections."
    },
    {
      "key": "data_availability",
      "label": "Data availability",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading",
      "hint": "This journal's class is approximated for compiles — special sections render as unnumbered sections."
    }
  ],
  "render_hints": {
    "layout": {
      "figure_widths_mm": {
        "single": 89,
        "oneAndHalf": 136,
        "double": 183
      },
      "figure_max_height_mm": 247,
      "allowed_placements": [
        "t",
        "p"
      ],
      "allow_here": false,
      "notes": "Nature: 89 mm single / 136 mm 1.5 / 183 mm double column; max height 247 mm. Floats at top of page or float pages."
    }
  },
  "look": {
    "engine": "spec",
    "name": "Nature family (published page)",
    "measured_from": "Nature Communications 11:20 (2020) — page 595.3×782.4 bp, two columns",
    "page": {
      "w": 595.3,
      "h": 782.4
    },
    "margins": {
      "top": 50.2,
      "bottom": 42.7,
      "left": 43.6,
      "right": 43.6
    },
    "columns": 2,
    "colsep": 11.9,
    "fonts": {
      "text": "libertinus",
      "sans": "heros"
    },
    "body": {
      "size": 9.5,
      "lead": 10.5,
      "indent": 9.5,
      "parskip": 0,
      "flushbottom": true
    },
    "title": {
      "family": "sans",
      "size": 22.5,
      "lead": 25.5,
      "weight": "normal",
      "align": "left",
      "after": 12
    },
    "authors": {
      "family": "sans",
      "size": 10,
      "lead": 13,
      "align": "left",
      "after": 30,
      "and": "&"
    },
    "affiliations": {
      "family": "sans",
      "size": 7,
      "lead": 8.5,
      "align": "left",
      "where": "footnote",
      "after": 0,
      "inline": true
    },
    "abstract": {
      "mode": "span",
      "family": "sans",
      "size": 9.5,
      "lead": 13.6,
      "weight": "normal",
      "label": null,
      "indent": 0,
      "width": 372,
      "before": 0,
      "after": 18
    },
    "keywords": {
      "show": false
    },
    "front_page_alone": true,
    "hide_heading_kinds": [
      "introduction"
    ],
    "h1": {
      "family": "sans",
      "size": 9.5,
      "lead": 10.5,
      "weight": "bold",
      "before": 10,
      "after": 2,
      "align": "left"
    },
    "h2": {
      "family": "text",
      "size": 9.5,
      "lead": 10.5,
      "weight": "bold",
      "before": 4,
      "after": 0,
      "align": "left"
    },
    "h3": {
      "family": "text",
      "size": 9.5,
      "lead": 10.5,
      "weight": "bold",
      "before": 4,
      "after": 0,
      "runin": true,
      "runin_sep": ".",
      "align": "left"
    },
    "caption": {
      "family": "sans",
      "size": 8.0,
      "lead": 9.8,
      "label_fig": "Fig.",
      "label_tab": "Table",
      "label_weight": "bold",
      "sep": " ",
      "align": "justify",
      "skip": 6,
      "table_position": "above"
    },
    "bib": {
      "size": 7.0,
      "lead": 8.7,
      "head": "References",
      "label": "dot",
      "sep": 0.5
    },
    "cite": {
      "style": "super"
    },
    "display": {
      "above": 6,
      "below": 6
    },
    "floats": {
      "textfloatsep": 14,
      "floatsep": 12,
      "intextsep": 10,
      "topfraction": 0.9,
      "bottomfraction": 0.5,
      "textfraction": 0.08,
      "floatpagefraction": 0.8,
      "dbltopfraction": 0.9,
      "dblfloatpagefraction": 0.8,
      "topnumber": 3,
      "bottomnumber": 1,
      "totalnumber": 4,
      "dbltopnumber": 2
    },
    "footer": {
      "page_numbers": true
    },
    "section_styles": {
      "methods": {
        "size": 7.5,
        "lead": 8.5,
        "indent": 7.5,
        "h2": {
          "family": "text",
          "size": 7.5,
          "lead": 8.5,
          "weight": "bold",
          "runin": true,
          "runin_sep": ".",
          "before": 3
        }
      },
      "data_availability": {
        "size": 7.0,
        "lead": 8.7,
        "indent": 7
      },
      "acknowledgements": {
        "size": 7.0,
        "lead": 8.7,
        "indent": 7
      },
      "author_contributions": {
        "size": 7.0,
        "lead": 8.7,
        "indent": 7
      },
      "competing_interests": {
        "size": 7.0,
        "lead": 8.7,
        "indent": 7
      }
    }
  },
  "figure_environment": {
    "compiled_columns": 1,
    "env": "figure",
    "placement": "H",
    "default_width": "0.9\\linewidth"
  },
  "table_environment": {
    "caption_position": "below",
    "env": "table",
    "placement": "H",
    "use_booktabs": true
  },
  "equation_environment": {
    "display": "equation",
    "inline_delim": "$"
  }
}
