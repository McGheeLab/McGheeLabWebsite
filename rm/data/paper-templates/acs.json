{
  "schema_version": 2,
  "id": "acs",
  "name": "ACS journal (achemso)",
  "group": "Publishers",
  "description": "American Chemical Society journal format via the achemso class (JACS defaults; change journal=jacsat in the preamble for other ACS titles). Class-managed superscript numeric citations, achemso author/affiliation block, achemso.bst bibliography. Suggested add-on: mhchem for \\ce{} chemical formulas. achemso ships with TeXLive.",
  "modular": true,
  "main_file": "main.tex",
  "bib_filename": "references.bib",
  "citation": {
    "command": "\\cite",
    "narrative_command": "\\citet",
    "render_family": "superscript",
    "bibliography_style": "achemso"
  },
  "refs": {
    "figure": {
      "prefix": "Figure~"
    },
    "table": {
      "prefix": "Table~"
    },
    "equation": {
      "prefix": "Eq.~",
      "command": "\\eqref"
    }
  },
  "author_block": {
    "format": "achemso"
  },
  "limits": {},
  "addon_defaults": [],
  "preamble": "\\documentclass[journal=jacsat,manuscript=article]{achemso}\n\n% Generated by ResearchManagement paper builder — ACS (achemso) template.\n% achemso manages citations, the author block, and the bibliography style.\n\\usepackage[utf8]{inputenc}\n\\usepackage[T1]{fontenc}\n\\usepackage{amsmath, amssymb}\n\\usepackage{graphicx}\n\\usepackage{booktabs}\n\\usepackage{chemformula}\n\\usepackage{float}\n",
  "main_template": "{{PREAMBLE}}\n\n\\title{ {{TITLE}} }\n{{AUTHOR_BLOCK}}\n\n\\begin{document}\n\n\\begin{abstract}\n{{ABSTRACT}}\n\\end{abstract}\n\n\\maketitle\n\n{{INPUTS}}\n\n\\bibliography{{{BIB_BASENAME}}}\n\n\\end{document}\n",
  "section_kind_to_command": {
    "abstract": "abstract_placeholder",
    "keywords": "skip",
    "introduction": "section",
    "background": "section",
    "methods": "section",
    "results": "section",
    "discussion": "section",
    "conclusions": "section",
    "acknowledgements": "section_star",
    "references": "skip",
    "custom": "section"
  },
  "default_section_label": {
    "abstract": "Abstract",
    "introduction": "Introduction",
    "background": "Background",
    "methods": "Experimental Section",
    "results": "Results and Discussion",
    "discussion": "Discussion",
    "conclusions": "Conclusion",
    "acknowledgements": "Acknowledgement"
  },
  "special_sections": [
    {
      "key": "acknowledgement",
      "label": "Acknowledgement",
      "command": {
        "type": "env",
        "name": "acknowledgement"
      },
      "singleton": true,
      "default_position": "back",
      "preview": "heading",
      "hint": "achemso’s real acknowledgement environment."
    },
    {
      "key": "suppinfo",
      "label": "Supporting Information Available",
      "command": {
        "type": "env",
        "name": "suppinfo"
      },
      "singleton": true,
      "default_position": "back",
      "preview": "heading",
      "hint": "achemso’s real suppinfo environment."
    },
    {
      "key": "author_contributions",
      "label": "Author Contributions",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    },
    {
      "key": "data_availability",
      "label": "Data Availability",
      "command": "section_star",
      "singleton": true,
      "default_position": "back",
      "preview": "heading"
    }
  ],
  "render_hints": {
    "layout": {
      "figure_widths_mm": {
        "single": 84.6,
        "oneAndHalf": null,
        "double": 177.8
      },
      "figure_max_height_mm": 241,
      "allowed_placements": [
        "t",
        "p"
      ],
      "allow_here": false,
      "notes": "ACS: 3.33 in (84.6 mm) single / 7 in (177.8 mm) double column; max height 9.5 in (241 mm)."
    }
  },
  "look": {
    "engine": "spec",
    "name": "ACS journal (published page)",
    "measured_from": "J. Am. Chem. Soc. 148, 5253 (2026) — 607.4×800.9 bp, two columns",
    "page": {
      "w": 607.4,
      "h": 800.9
    },
    "margins": {
      "top": 60.2,
      "bottom": 45.7,
      "left": 51.5,
      "right": 51.9
    },
    "columns": 2,
    "colsep": 23.9,
    "fonts": {
      "text": "garamond",
      "sans": "source-sans"
    },
    "body": {
      "size": 10,
      "lead": 11.1,
      "indent": 10,
      "parskip": 0,
      "flushbottom": true
    },
    "title": {
      "family": "sans",
      "size": 14.5,
      "lead": 17,
      "weight": "bold",
      "align": "left",
      "after": 6
    },
    "authors": {
      "family": "sans",
      "size": 10,
      "lead": 12,
      "align": "left",
      "after": 4
    },
    "affiliations": {
      "family": "text",
      "size": 8,
      "lead": 9.5,
      "align": "left",
      "where": "front",
      "after": 8
    },
    "abstract": {
      "mode": "span",
      "family": "text",
      "size": 9,
      "lead": 10.6,
      "label": "ABSTRACT:",
      "label_style": "runin",
      "indent": 0,
      "after": 14,
      "box": {
        "bg": 0.93,
        "pad": 6
      }
    },
    "keywords": {
      "show": false
    },
    "h1": {
      "family": "sans",
      "size": 10,
      "lead": 12,
      "weight": "bold",
      "before": 10,
      "after": 4,
      "case": "upper",
      "align": "left"
    },
    "h2": {
      "family": "sans",
      "size": 10,
      "lead": 11.1,
      "weight": "bold",
      "before": 4,
      "after": 0,
      "runin": true,
      "runin_sep": ".",
      "align": "left"
    },
    "h3": {
      "family": "text",
      "size": 10,
      "lead": 11.1,
      "style": "italic",
      "before": 3,
      "after": 0,
      "runin": true,
      "runin_sep": "."
    },
    "caption": {
      "family": "text",
      "size": 9,
      "lead": 10.2,
      "label_fig": "Figure",
      "label_tab": "Table",
      "label_weight": "bold",
      "sep": ". ",
      "align": "justify",
      "skip": 6,
      "table_position": "above"
    },
    "bib": {
      "size": 8.5,
      "lead": 9.8,
      "head": "References",
      "label": "paren",
      "sep": 0.5
    },
    "cite": {
      "style": "super"
    },
    "display": {
      "above": 6,
      "below": 6
    },
    "floats": {
      "textfloatsep": 14,
      "floatsep": 12,
      "intextsep": 10,
      "topfraction": 0.9,
      "bottomfraction": 0.5,
      "textfraction": 0.08,
      "floatpagefraction": 0.8,
      "dbltopfraction": 0.9,
      "dblfloatpagefraction": 0.8,
      "topnumber": 3,
      "bottomnumber": 1,
      "totalnumber": 4,
      "dbltopnumber": 2
    },
    "footer": {
      "page_numbers": true
    }
  },
  "figure_environment": {
    "compiled_columns": 1,
    "env": "figure",
    "placement": "H",
    "default_width": "0.9\\linewidth"
  },
  "table_environment": {
    "caption_position": "below",
    "env": "table",
    "placement": "H",
    "use_booktabs": true
  },
  "equation_environment": {
    "display": "equation",
    "inline_delim": "$"
  }
}
