    {
      "_comment": "V3.646 — the cheap-freshness probe at api-firestore-adapter.js:440-441 runs .where('kind','==',<k>).orderBy('updatedAt','desc').limit(1) on every inventory page load. With no index it threw into the catch-and-fall-through at :401-403 and refetched all 777 docs. Keyed on the FIELD not the value, so this one index serves items, chemicals AND stock.",
      "collectionGroup": "inventory",
      "queryScope": "COLLECTION",
      "fields": [
        {
          "fieldPath": "kind",
          "order": "ASCENDING"
        },
        {
          "fieldPath": "updatedAt",
          "order": "DESCENDING"
        }
      ]
    },
